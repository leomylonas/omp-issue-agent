{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.Async" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "Enrich": [ "FromLogContext" ],
    "WriteTo": [
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "Console",
              "Args": {
                "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
              }
            }
          ]
        }
      }
    ]
  },
  "OpenTelemetry": {
    "OtlpEndpoint": "",
    "TraceSamplingRatio": 1.0
  },
  "IssueAgent": {
    "pollInterval": "00:01:00",
    "shutdownGracePeriod": "00:00:15",
    "concurrency": {
      "agent": 3,
      "polling": 10
    },
    "workspace": {
      "rootPath": "/data"
    },
    "omp": {
      "executablePath": "/usr/local/bin/omp",
      "authBrokerUrl": "",
      "connectionSettings": {},
      "executionSecrets": {}
    },
    "notifications": {},
    "providers": []
  }
}
