# Add provider and repository settings for your deployment. Reference mounted secrets by file, for example:
# IssueAgent__Providers__0__Token__File=/run/secrets/github_token

# Optional OTLP tracing:
# OpenTelemetry__OtlpEndpoint=http://otel-collector:4317
# OpenTelemetry__TraceSamplingRatio=1.0

# Optional Telegram notifications:
# IssueAgent__Notifications__Telegram__BotToken__File=/run/secrets/telegram_bot_token
# IssueAgent__Notifications__Telegram__ChatId=replace-me

# Optional Slack notifications:
# IssueAgent__Notifications__Slack__WebhookUrl__File=/run/secrets/slack_webhook_url
